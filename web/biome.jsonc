{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "root": true,
    "vcs": { "enabled": false },
    "files": { "includes": ["src/**"] },
    "assist": {
        "enabled": true,
        "actions": {
            "recommended": true,
            "source": { "recommended": true, "organizeImports": "on", "useSortedAttributes": "on" }
        }
    },
    "formatter": { "enabled": true },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "a11y": "off",
            "nursery": {
                "useSortedClasses": { "level": "warn", "fix": "safe", "options": { "functions": ["clsx", "cva", "cn"] } }
            }
        }
    },
    "html": { "formatter": { "enabled": true } },
    "javascript": { "assist": { "enabled": true }, "formatter": { "enabled": true }, "linter": { "enabled": true } },
    "css": {
        "assist": { "enabled": true },
        "formatter": { "enabled": true },
        "linter": { "enabled": true },
        "parser": { "cssModules": true, "tailwindDirectives": true }
    }
}
